# terraform.tfvars.example
# Copy to terraform.tfvars and fill in values.
# terraform.tfvars is git-ignored — NEVER commit real secrets.

aws_region          = "ap-south-1"
environment         = "dev"
project_name        = "sarvavaidya"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["ap-south-1a", "ap-south-1b"]

# EC2
instance_type    = "t3.medium"
key_pair_name    = "sarvavaidya-keypair"
allowed_ssh_cidr = "YOUR_IP/32"   # replace with your actual IP

# RDS Aurora
db_instance_class        = "db.t3.medium"
db_name                  = "sarvavaidya"
db_username              = "sarvavaidya"
db_password              = "CHANGE_ME_STRONG_PASSWORD"   # min 8 chars
db_backup_retention_days = 7
