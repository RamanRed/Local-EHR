# /opt/sarvavaidya/apps/server/.env
# Generated by Ansible — do not edit manually on server.
# Values come from AWS SSM Parameter Store at deploy time.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="{{ db_url }}"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="{{ jwt_secret }}"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://{{ ansible_host }}

# ── AI APIs ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY="{{ gemini_api_key | default('') }}"
GROK_API_KEY="{{ grok_api_key | default('') }}"
OPENAI_API_KEY="{{ openai_api_key | default('') }}"
OPENAI_API_SPEECH_KEY="{{ openai_api_speech_key | default('') }}"
OPENAI_VECTOR_STORE_ID="{{ openai_vector_store_id | default('') }}"

# ── Vector DB ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY="{{ pinecone_api_key | default('') }}"
PINECONE_INDEX="{{ pinecone_index | default('quickstart') }}"
PINECONE_NAMESPACE="{{ pinecone_namespace | default('medical_ai_diseases') }}"
PINECONE_DIMENSION="{{ pinecone_dimension | default('1536') }}"

# ── File Upload ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="{{ cloudinary_cloud_name | default('') }}"
CLOUDINARY_API_KEY="{{ cloudinary_api_key | default('') }}"
CLOUDINARY_API_SECRET="{{ cloudinary_api_secret | default('') }}"

# ── Python / Transcription ────────────────────────────────────────────────────
PYTHON_EXECUTABLE=/usr/bin/python3
OLLAMA_AUDIO_MODEL=qwen2-audio
OLLAMA_WHISPER_MODEL=whisper
