# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sarvavaidya:sarvavaidya@localhost:5435/sarvavaidya"
# For Aurora (AWS prod):
# DATABASE_URL="postgresql://sarvavaidya:PASSWORD@AURORA_ENDPOINT:5432/sarvavaidya"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-secret"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=dev
FRONTEND_URL=http://localhost:5173

# ── AI APIs — Primary (Gemini) ────────────────────────────────────────────────
GEMINI_API_KEY=

# ── AI APIs — Grok (xAI) — alternative LLM provider ──────────────────────────
# Get your key at: https://console.x.ai/
# Model: grok-beta or grok-2-1212
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# ── AI APIs — OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_SPEECH_KEY=
OPENAI_VECTOR_STORE_ID=

# ── Vector DB (Pinecone) ──────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=quickstart
PINECONE_NAMESPACE=medical_ai_diseases
PINECONE_DIMENSION=1536

# ── File Upload (Cloudinary) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Speech / Transcription ────────────────────────────────────────────────────
PYTHON_EXECUTABLE=python3
OLLAMA_AUDIO_MODEL=qwen2-audio
OLLAMA_WHISPER_MODEL=whisper

# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_API_TOKEN=
